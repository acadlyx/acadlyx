# Backend API ORIGIN only — no /api/v1 suffix, no trailing slash.
# The client appends /api/v1 itself (see src/lib/api.ts).
#
# Local development (backend defaults to PORT=5001):
NEXT_PUBLIC_API_URL=http://localhost:5001
#
# Vercel production: set this to the Render service URL, e.g.
# NEXT_PUBLIC_API_URL=https://acadlyx-api.onrender.com
