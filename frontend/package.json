{
  "name": "acadlyx-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:source && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:source": "node scripts/validate-source.mjs && node scripts/test-placement-auth.mjs && node scripts/test-library-access.mjs && node scripts/test-student-ui-integrity.mjs && node scripts/test-finance-access.mjs"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.5.25",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "24.x"
  }
}
