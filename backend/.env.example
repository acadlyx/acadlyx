# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# CORS — set this to the deployed frontend origin in production.
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL via Prisma)
# Example (Neon/Supabase/local Postgres):
DATABASE_URL="postgresql://user:password@localhost:5432/acadlyx?schema=public"

# --- Auth (Phase 1) ---
# Generate strong random values, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
BCRYPT_SALT_ROUNDS=10

# Password used ONLY by prisma/seed.ts to create demo accounts.
# Change this before seeding anything beyond local development.
SEED_DEMO_PASSWORD=ChangeMe123!

# --- Reserved for future phases (do not implement yet) ---
# CLOUDINARY_URL=
# REDIS_URL=
