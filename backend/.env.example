# ---------------------------------------------------------
# ACADLYX API — environment
# ---------------------------------------------------------

NODE_ENV=development
PORT=5001
API_VERSION=v1

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/acadlyx

# ---------------------------------------------------------
# Authentication
# ---------------------------------------------------------

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
BCRYPT_SALT_ROUNDS=10

# Brute-force protection. An account locks for AUTH_LOCKOUT_MINUTES
# after AUTH_MAX_FAILED_ATTEMPTS consecutive failures.
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCKOUT_MINUTES=15

# Password reset token lifetime.
AUTH_RESET_TTL_MINUTES=30

# When false (the default) the reset token is returned in the API
# response so an institution without SMTP can still complete the flow
# from the admin console. Set to true once a mailer is wired up.
MAIL_ENABLED=false

# ---------------------------------------------------------
# Payments
#
# The fee module talks to a provider-independent adapter. With
# PAYMENT_PROVIDER unset or `manual`, only counter/offline collection is
# available and every online endpoint fails with a clear configuration
# error rather than pretending to have taken money.
#
# Supported: manual | razorpay | stripe  (HMAC-signature contract)
# ---------------------------------------------------------

PAYMENT_PROVIDER=manual
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# ---------------------------------------------------------
# Media uploads (optional)
# ---------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to false to skip the RBAC/entitlement reconciliation on boot.
RBAC_SYNC_ON_BOOT=true

# ---------------------------------------------------------
# Production / Render notes
# ---------------------------------------------------------
# NODE_ENV=production
# CORS_ORIGIN=https://your-vercel-domain.vercel.app
# DATABASE_URL=<Supabase PostgreSQL connection string>
# JWT_ACCESS_SECRET=<at least 32 random characters>
# JWT_REFRESH_SECRET=<at least 32 random characters>
