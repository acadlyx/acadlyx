  updatedAt     DateTime @updatedAt
  fines         LibraryFine[]
  @@index([institutionId, borrowerId, status])
  @@index([institutionId, dueDate, status])
  @@index([institutionId, bookId, status])
  @@map("library_issues")
}

model LibraryFine {
  id                 String   @id @default(uuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  issueId            String
  issue              LibraryIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  studentId          String
  student            User @relation("LibraryFineStudent", fields: [studentId], references: [id], onDelete: Cascade)
  type               String
  originalAmount     Decimal  @db.Decimal(14,2)
  waivedAmount       Decimal  @default(0) @db.Decimal(14,2)
  reason             String
  status             String   @default("OUTSTANDING")
  requestedById      String?
  approvedById       String?
  approvedAt         DateTime?
  waiverReason       String?
  financialInvoiceId String?
  financialInvoice   FeeInvoice? @relation(fields: [financialInvoiceId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([issueId, type])
  @@index([institutionId, studentId, status])
  @@index([institutionId, issueId])
  @@index([financialInvoiceId])
  @@map("library_fines")
}

model FeeReceipt {
