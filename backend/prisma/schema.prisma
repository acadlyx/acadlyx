}


// ==========================================================
// AUTHENTICATION HARDENING
// ==========================================================

/// Single-use password reset grant. Only the SHA-256 hash of the token
/// is stored, so a database read never yields a usable reset link.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

/// One-time MFA bypass code, hashed. Consumed on use and never reissued.
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Short-lived handle issued after a correct password when MFA is on.
/// It is not an access token: it only authorises the second factor step.
model MfaChallenge {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeHash String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  attempts      Int       @default(0)
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("mfa_challenges")
}
