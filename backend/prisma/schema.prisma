// ACADLYX — Prisma schema
// Phase 1: multi-tenant foundation — Institution, User, RBAC, auth,
// audit log.
// Phase 2: academic structure — Campus, Department, Program,
// AcademicYear, Semester, Section, Course, CourseOffering.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// TENANT
// ==========================================================

/// A single institution (tenant).
/// not a special case in code.
model Institution {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  adminOfficeEmail String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users     User[]
  studentProfiles StudentProfile[]
  roles     Role[]
  auditLogs AuditLog[]
  domainEvents DomainEventOutbox[]

  /// Explicit campus assignments used by Director-level authorization.
  campusAccesses         CampusAccess[]

  campuses              Campus[]
  departments           Department[]
  programs              Program[]
  academicYears         AcademicYear[]
  batches               Batch[]
  semesters             Semester[]
  sections              Section[]
  courses               Course[]
  courseOfferings       CourseOffering[]
  studentEnrollments    StudentEnrollment[]
  attendanceSessions    AttendanceSession[]
  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  internalMarks         InternalMark[]
  skills                Skill[]
  targetRoles           TargetRole[]
  opportunities         Opportunity[]
  studentSkills         StudentSkill[]
  applications          Application[]
  timetableEntries      TimetableEntry[]
  exams                 Exam[]
  examResults           ExamResult[]
  feeHeads              FeeHead[]
  feeStructures         FeeStructure[]
  feeInvoices           FeeInvoice[]
  feePayments           FeePayment[]
  feeConcessions        FeeConcession[]
  feeRefunds            FeeRefund[]
  feeTransactions      FeeTransaction[]
  receipts              FeeReceipt[]
  notices               Notice[]
  documents             Document[]
  notifications         Notification[]
  parentStudentLinks    ParentStudentLink[]
  siteContents          SiteContent[]
  institutionalCmsContent InstitutionalCmsContent?
  subscription          TenantSubscription?
  featureEntitlements   TenantFeatureEntitlement[]
  files                 FileAsset[]

  admissionApplications AdmissionApplication[]
  employeeProfiles EmployeeProfile[]
  leaveTypes LeaveType[]
  leaveRequests LeaveRequest[]
  libraryBooks LibraryBook[]
  libraryIssues LibraryIssue[]
  libraryFines LibraryFine[]
  calendarEvents CalendarEvent[]
  courseRegistrations CourseRegistration[]
  movementRequests StudentMovementRequest[]
  certificates Certificate[]

  programmeOutcomes       ProgrammeOutcome[]
  courseOutcomes          CourseOutcome[]
  courseOutcomeMappings   CourseOutcomeMapping[]
  obeAssessments          ObeAssessment[]
  obeAssessmentItems      ObeAssessmentItem[]
  obeAssessmentScores     ObeAssessmentScore[]
  obeAttainmentPolicies   ObeAttainmentPolicy[]
  obeIndirectAssessments  ObeIndirectAssessment[]
  obeCourseAttainments    ObeCourseAttainment[]
  obeAttainmentRuns       ObeAttainmentRun[]
  obeRunCourseOutcomes    ObeRunCourseOutcome[]
  obeRunProgrammeOutcomes ObeRunProgrammeOutcome[]

  @@index([isActive])
  @@map("institutions")
}

/// Tenant commercial state is deliberately separate from RBAC.  A user may
/// have a permission but still cannot use a module that the tenant has not
/// purchased or has been suspended from using.
model TenantSubscription {
  id             String      @id @default(uuid())
  institutionId  String      @unique
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  plan           String      @default("STANDARD")
  status         String      @default("ACTIVE") // TRIAL | ACTIVE | EXPIRED | SUSPENDED | CANCELLED
  trialEndsAt    DateTime?
  expiresAt      DateTime?
  renewsAt       DateTime?
  studentLimit   Int?
  userLimit      Int?
  facultyLimit   Int?
  storageLimitMb Int?
  planId             String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  entitlements TenantFeatureEntitlement[]

  @@index([status])
  @@map("tenant_subscriptions")
}

/// One authoritative enabled/limit/override record per tenant feature.
model TenantFeatureEntitlement {
  id             String             @id @default(uuid())
  institutionId  String
  institution    Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  featureKey     String
  isEnabled      Boolean            @default(true)
  limitValue     Int?
  override       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([institutionId, featureKey])
  @@index([subscriptionId])
  @@map("tenant_feature_entitlements")
}

// ==========================================================
// USERS
// ==========================================================

/// A person who can log in. institutionId is null only for
/// platform-level users (SUPER_ADMIN). Every other user belongs
/// to exactly one institution.
model User {
  id            String       @id @default(uuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  email        String    @unique
  idNumber     String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  /// Authentication hardening. MFA is TOTP (RFC 6238); the secret is
  /// stored encrypted at rest by auth.mfa.service and is never returned
  /// to a client after enrolment.
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  mfaEnrolledAt       DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  mustChangePassword  Boolean   @default(false)

  deletedAt            DateTime?
  deletedBy            String?
  deletedByUser        User?     @relation("UserDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  deletionReason       String?
  deletionNote         String?
  recoveryDeadline     DateTime?
  permanentlyDeletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles               UserRole[]
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  domainEvents            DomainEventOutbox[]
  facultyCourseOfferings  CourseOffering[]       @relation("CourseOfferingFaculty")
  studentEnrollments      StudentEnrollment[]
  profile                   StudentProfile?
  attendanceSessionsTaken AttendanceSession[]    @relation("AttendanceSessionFaculty")
  attendanceRecordsOwned  AttendanceRecord[]     @relation("AttendanceRecordStudent")
  assignmentsCreated      Assignment[]           @relation("AssignmentCreatedBy")
  assignmentSubmissions   AssignmentSubmission[] @relation("AssignmentSubmissionStudent")
  assignmentReviews       AssignmentSubmission[] @relation("AssignmentSubmissionReviewedBy")
  internalMarksReceived   InternalMark[]         @relation("InternalMarkStudent")
  internalMarksEntered    InternalMark[]         @relation("InternalMarkEnteredBy")
  departmentAccesses      DepartmentAccess[]
  campusAccesses           CampusAccess[]
  studentSkills           StudentSkill[]
  careerPaths             CareerPath[]
  applications            Application[]
  parentLinks             ParentStudentLink[]    @relation("ParentLinks")
  childLinks              ParentStudentLink[]    @relation("ChildLinks")
  examResults             ExamResult[]
  feeInvoices             FeeInvoice[]
  feePayments             FeePayment[]
  feeConcessionsCreated   FeeConcession[] @relation("FeeConcessionCreatedBy")
  feeConcessionStudents   FeeConcession[] @relation("FeeConcessionStudent")
  feeConcessionsApproved  FeeConcession[] @relation("FeeConcessionApprovedBy")
  feeRefundsRequested     FeeRefund[] @relation("FeeRefundRequestedBy")
  feeRefundsApproved      FeeRefund[] @relation("FeeRefundApprovedBy")
  feeRefundsProcessed     FeeRefund[] @relation("FeeRefundProcessedBy")
  feeTransactions         FeeTransaction[] @relation("FeeTransactionCreatedBy")
  feeTransactionStudents  FeeTransaction[] @relation("FeeTransactionStudent")
  feeRefundStudents       FeeRefund[] @relation("FeeRefundStudent")
  feeReceiptsIssued       FeeReceipt[] @relation("FeeReceiptIssuedBy")
  feeReceiptStudents      FeeReceipt[] @relation("FeeReceiptStudent")
  feeStructuresCreated    FeeStructure[] @relation("FeeStructureCreatedBy")
  documents               Document[]             @relation("DocumentOwner")
  notifications           Notification[]

  deletedUsers            User[] @relation("UserDeletedBy")

  employeeProfile EmployeeProfile?
  leaveRequests LeaveRequest[] @relation("LeaveApplicant")
  libraryIssues LibraryIssue[] @relation("LibraryBorrower")
  libraryFines LibraryFine[] @relation("LibraryFineStudent")
  courseRegistrations CourseRegistration[] @relation("RegistrationStudent")
  movementRequests StudentMovementRequest[] @relation("MovementStudent")
  certificates Certificate[] @relation("CertificateStudent")

  obeMappingsCreated    CourseOutcomeMapping[] @relation("ObeMappingCreatedBy")
  obeMappingsApproved   CourseOutcomeMapping[] @relation("ObeMappingApprovedBy")
  obeAssessmentsCreated ObeAssessment[] @relation("ObeAssessmentCreatedBy")
  obeScoresReceived     ObeAssessmentScore[] @relation("ObeScoreStudent")
  obeScoresEntered      ObeAssessmentScore[] @relation("ObeScoreEnteredBy")
  obeRunsCalculated     ObeAttainmentRun[] @relation("ObeRunCalculatedBy")
  obeRunsApproved       ObeAttainmentRun[] @relation("ObeRunApprovedBy")

  passwordResetTokens PasswordResetToken[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  mfaChallenges       MfaChallenge[]

  @@index([institutionId])
  @@index([deletedAt])
  @@index([recoveryDeadline])
  @@index([institutionId, isActive, deletedAt])
  @@index([institutionId, createdAt])
  @@map("users")
}

// ==========================================================
// RBAC
// ==========================================================

/// A named role. Institution-scoped except SUPER_ADMIN, which is
/// a platform role (institutionId null). Institutions are not
/// hard-coded to a fixed role list — new roles can be inserted
/// per institution without a schema change.
model Role {
  id            String       @id @default(uuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("roles")
}

/// A single grantable capability, e.g. "students.read".
/// Global catalog shared across all institutions.
model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  module      String
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Join table: which permissions a role grants.
model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Join table: which role(s) a user has. A user's effective
/// institution/tenant context for authorization purposes comes
/// from their roles, never from client input.
model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==========================================================
// AUTH
// ==========================================================

/// Opaque refresh tokens, stored only as a SHA-256 hash.
/// Supports rotation + reuse detection.
model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================================
// AUDIT
// ==========================================================

/// Foundation for audit logging of sensitive actions.
/// institutionId/userId are nullable so a log survives deletion
/// of the institution or user it references.
model AuditLog {
  id            String       @id @default(uuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([institutionId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// ==========================================================
// ACADEMIC STRUCTURE (Phase 2)
// ==========================================================
//
// Institution → Campus (optional) → Department → Program → Semester
// (a program's Nth semester, occurring within a specific AcademicYear)
// → Section (a group of students within that semester) → CourseOffering
// (a Course taught in that Semester+Section by a faculty User).
//
// There is no separate "Faculty" model — a faculty member is simply
// a User holding the FACULTY role (see Phase 1 RBAC); CourseOffering
// references User directly via facultyId.
//
// Student enrollment (linking a future Student record to a Program
// and Section) is intentionally NOT modeled yet — that arrives with
// the Student model in Phase 3, so it isn't half-built here.
//
// Academic history is preserved by never deleting AcademicYear/
// Semester rows when a new year/semester starts — old ones are just
// no longer "current". CourseOfferings are scoped to a specific
// Semester, so a course taught across multiple semesters produces
// multiple CourseOffering rows, not overwritten history.

/// A physical/administrative campus. Optional today (
/// campus) but modeled from the start so multi-campus institutions
/// don't require a schema change later.
model Campus {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  name     String
  code     String
  address  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  campusAccesses CampusAccess[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("campuses")
}

model Department {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String?
  campus        Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)

  name     String
  code     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs           Program[]
  courses            Course[]
  departmentAccesses DepartmentAccess[]

  employeeProfiles EmployeeProfile[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([campusId])
  @@map("departments")
}

model Program {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  name          String
  code          String
  /// Free text on purpose (e.g. "UG", "PG", "DIPLOMA") — not every
  /// institution uses the same program levels.
  level         String
  durationYears Int
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters Semester[]
  batches Batch[]
  programmeOutcomes ProgrammeOutcome[]
  obeAttainmentRuns ObeAttainmentRun[]
  obePolicies ObeAttainmentPolicy[]

  studentEnrollments StudentEnrollment[]
  feeStructures FeeStructure[]

  admissionApplications AdmissionApplication[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([departmentId])
  @@map("programs")
}

/// A concrete academic year, e.g. "2025-2026". Never deleted when a
/// new year starts — preserves academic history.
model AcademicYear {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters Semester[]

  studentEnrollments StudentEnrollment[]
  feeStructures FeeStructure[]

  admissionApplications AdmissionApplication[]
  calendarEvents CalendarEvent[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("academic_years")
}

/// A student cohort spanning an admission/start year through its expected completion year.
/// Batch is intentionally distinct from AcademicYear: an academic year describes
/// the institution's operating year, while a batch describes a student's cohort.
model Batch {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programId     String
  program       Program     @relation(fields: [programId], references: [id], onDelete: Cascade)

  name              String
  code              String
  admissionYear     Int
  completionYear    Int
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentEnrollments StudentEnrollment[]

  @@unique([institutionId, code])
  @@index([institutionId, programId])
  @@index([programId, admissionYear])
  @@map("batches")
}

/// A program's Nth semester, occurring in a specific academic year.
/// e.g. "B.Tech CSE, Semester 3, 2025-2026".
model Semester {
  id             String       @id @default(uuid())
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  number    Int
  name      String
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections        Section[]
  courseOfferings CourseOffering[]
  feeStructures FeeStructure[]
  studentEnrollments StudentEnrollment[]

  @@unique([programId, academicYearId, number])
  @@index([institutionId])
  @@index([programId])
  @@index([academicYearId])
  @@map("semesters")
}

/// A group of students within a semester, e.g. "Section A".
/// Student membership is added in Phase 3.
model Section {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semesterId    String
  semester      Semester    @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  name     String
  capacity Int?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseOfferings CourseOffering[]

  studentEnrollments StudentEnrollment[]

  @@unique([semesterId, name])
  @@index([institutionId])
  @@index([semesterId])
  @@map("sections")
}

/// A subject owned by a department, e.g. "Database Management
/// Systems". Not tied to any one semester — CourseOffering is what
/// schedules it into a specific Semester+Section.
model Course {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  code        String
  name        String
  credits     Int
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseOfferings CourseOffering[]
  courseOutcomes CourseOutcome[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([departmentId])
  @@map("courses")
}

/// The concrete scheduling of a Course into a Semester+Section,
/// optionally assigned to a faculty User. A course taught across
/// multiple semesters produces multiple rows here — history is
/// never overwritten.
model CourseOffering {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId    String
  semester      Semester    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  facultyId     String?
  faculty       User?       @relation("CourseOfferingFaculty", fields: [facultyId], references: [id], onDelete: SetNull)

  /// Seat limit for self-registration. Null falls back to the section capacity.
  capacity          Int?
  /// When false the offering is closed to new student registrations.
  registrationOpen  Boolean @default(true)
  /// Elective offerings require approval and are not auto-rostered by section.
  isElective        Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceSessions AttendanceSession[]
  assignments        Assignment[]
  internalMarks      InternalMark[]
  timetableEntries   TimetableEntry[]
  exams              Exam[]

  obeAssessments         ObeAssessment[]
  obeIndirectAssessments ObeIndirectAssessment[]
  obeCourseAttainments   ObeCourseAttainment[]
  obeRunCourseOutcomes   ObeRunCourseOutcome[]

  registrations CourseRegistration[]

  @@unique([courseId, semesterId, sectionId])
  @@index([institutionId])
  @@index([courseId])
  @@index([semesterId])
  @@index([sectionId])
  @@index([facultyId])
  @@index([institutionId, semesterId, sectionId, isActive])
  @@index([institutionId, facultyId, semesterId, isActive])
  @@map("course_offerings")
}

// ==========================================================
// STUDENT MASTER (Phase 5)
// ==========================================================

/// Institution-scoped master record for a student. Authentication
/// remains on User; academic identity and admission data live here.
model StudentProfile {
  id                   String      @id @default(uuid())
  institutionId        String
  institution          Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId               String      @unique
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  admissionNumber      String
  dateOfBirth          DateTime?
  gender               String?
  bloodGroup           String?
  nationality          String?
  address              String?
  city                 String?
  state                String?
  postalCode           String?
  guardianName         String?
  guardianPhone        String?
  guardianEmail        String?
  emergencyContactName String?
  emergencyContactPhone String?
  admissionDate        DateTime?
  status               String      @default("ACTIVE") // ACTIVE | INACTIVE | GRADUATED | WITHDRAWN | TRANSFERRED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, admissionNumber])
  @@index([institutionId, status])
  @@index([institutionId, userId])
  @@map("student_profiles")
}

// ==========================================================
// STUDENT ENROLLMENT (Phase 3)
// ==========================================================

/// Links a User (holding the STUDENT role) to a Program for a given
/// AcademicYear, optionally to a Section. One row per student per
/// academic year — re-enrolling for a new year creates a NEW row
/// rather than overwriting the old one, so a student's academic
/// history (which program/section/year they were in) is preserved.
/// A full "Student" profile model (photo, guardian info, admission
/// details, etc.) is intentionally out of scope here — this model
/// only carries what the Student Portal needs: which
/// program/section/year the student currently belongs to.
model StudentEnrollment {
  id             String       @id @default(uuid())
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  semesterId     String?
  semester       Semester?     @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  sectionId      String?
  section        Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  rollNumber String?
  status     String  @default("ACTIVE") // ACTIVE | COMPLETED | DROPPED | TRANSFERRED

  enrolledAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, academicYearId])
  @@index([institutionId])
  @@index([userId])
  @@index([institutionId, userId, status])
  @@index([institutionId, rollNumber, status])
  @@index([programId])
  @@index([sectionId])
  @@index([semesterId])
  @@index([academicYearId])
  @@index([batchId])
  @@index([institutionId, batchId, semesterId, sectionId])
  @@index([institutionId, academicYearId, sectionId, status])
  @@map("student_enrollments")
}

// ==========================================================
// ATTENDANCE (Phase 4 — foundation; reports/analytics land in
// the dedicated Attendance phase later)
// ==========================================================

/// One class session for a CourseOffering on a given date.
/// Unique per (courseOffering, date) — a course meets its section
/// at most once per day in this model. Marking is idempotent:
/// re-opening an existing session's date returns the same row
/// rather than creating a duplicate.
model AttendanceSession {
  id               String         @id @default(uuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  facultyId        String
  faculty          User           @relation("AttendanceSessionFaculty", fields: [facultyId], references: [id], onDelete: Cascade)

  sessionDate DateTime  @db.Date
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?

  /// Finalisation. A locked session can only be changed through an
  /// approved AttendanceCorrectionRequest, never by direct marking.
  isLocked    Boolean   @default(false)
  lockedAt    DateTime?
  lockedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records AttendanceRecord[]

  @@unique([courseOfferingId, sessionDate])
  @@index([institutionId])
  @@index([institutionId, isSubmitted])
  @@index([facultyId])
  @@index([sessionDate])
  @@index([institutionId, courseOfferingId, sessionDate])
  @@map("attendance_sessions")
}

/// One student's mark within a session. Correcting a mark after
/// submission is allowed (upsert, not insert-only) — "submitted"
/// means the faculty has finished a first pass, not that the
/// record is frozen.
model AttendanceRecord {
  id                  String            @id @default(uuid())
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String
  student             User              @relation("AttendanceRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)

  status    String   @default("ABSENT") // PRESENT | ABSENT | LATE
  markedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

// ==========================================================
// ASSIGNMENTS (Phase 5)
// ==========================================================

/// A piece of coursework set for a CourseOffering. Only PUBLISHED
/// assignments are visible to students — DRAFT lets a faculty member
/// prepare one before students see it.
model Assignment {
  id               String         @id @default(uuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User           @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime
  maxMarks    Int
  status      String   @default("DRAFT") // DRAFT | PUBLISHED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions AssignmentSubmission[]

  @@index([institutionId])
  @@index([courseOfferingId])
  @@index([status])
  @@index([dueDate])
  @@index([institutionId, courseOfferingId, status, dueDate])
  @@map("assignments")
}

/// One student's submission for an Assignment. Resubmitting updates
/// this same row (unique per assignment+student) rather than
/// stacking history — "submit" is a write, not an append-only log.
model AssignmentSubmission {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assignmentId  String
  assignment    Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User        @relation("AssignmentSubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)

  content     String? // text submission; file upload is a later phase (Cloudinary/S3)
  status      String   @default("SUBMITTED") // SUBMITTED | LATE | REVIEWED
  submittedAt DateTime @default(now())

  marksAwarded Int?
  feedback     String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("AssignmentSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([institutionId])
  @@index([studentId])
  @@index([status])
  @@index([institutionId, studentId, status, submittedAt])
  @@map("assignment_submissions")
}

// ==========================================================
// INTERNAL MARKS (Phase 5)
// ==========================================================

/// One graded component (e.g. "Internal 1", "Quiz 2") for one
/// student in one CourseOffering. Multiple components accumulate as
/// separate rows rather than overwriting a single "marks" field, so
/// a course's full internal-assessment history is preserved.
model InternalMark {
  id               String         @id @default(uuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  studentId        String
  student          User           @relation("InternalMarkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  enteredById      String
  enteredBy        User           @relation("InternalMarkEnteredBy", fields: [enteredById], references: [id], onDelete: Cascade)

  component     String // e.g. "Internal 1", "Internal 2", "Quiz 1"
  marksObtained Float
  maxMarks      Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseOfferingId, studentId, component])
  @@index([institutionId])
  @@index([studentId])
  @@index([courseOfferingId])
  @@index([institutionId, courseOfferingId, studentId])
  @@map("internal_marks")
}

// ==========================================================
// INSTITUTIONAL + CAREER INTELLIGENCE
// ==========================================================

/// Explicit campus scope for Directors and other delegated leadership.
/// A Director's campus authority is never inferred from DepartmentAccess.
model CampusAccess {
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campusId     String
  campus       Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  scope        String @default("DIRECTOR")
  createdAt    DateTime @default(now())

  @@id([userId, campusId])
  @@index([campusId])
  @@map("campus_accesses")
}

/// Explicit departmental scope for HODs and delegated academic staff.
/// A role name alone never grants access to every department.
model DepartmentAccess {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  scope        String     @default("HOD")
  createdAt    DateTime   @default(now())

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("department_accesses")
}

model Skill {
  id            String         @id @default(uuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  category      String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  studentSkills StudentSkill[]
  roleSkills    RoleSkill[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("skills")
}

model TargetRole {
  id            String        @id @default(uuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  roleSkills    RoleSkill[]
  careerPaths   CareerPath[]
  opportunities Opportunity[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("target_roles")
}

model RoleSkill {
  targetRoleId String
  targetRole   TargetRole @relation(fields: [targetRoleId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  weight       Int        @default(1)
  minimumLevel Int        @default(60)

  @@id([targetRoleId, skillId])
  @@index([skillId])
  @@map("role_skills")
}

model StudentSkill {
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  proficiency   Int         @default(0) // transparent 0-100 rubric
  evidence      String?
  updatedAt     DateTime    @updatedAt

  @@id([studentId, skillId])
  @@index([institutionId])
  @@index([skillId])
  @@map("student_skills")
}

model CareerPath {
  id           String     @id @default(uuid())
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetRoleId String
  targetRole   TargetRole @relation(fields: [targetRoleId], references: [id], onDelete: Cascade)
  isPrimary    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([studentId, targetRoleId])
  @@index([targetRoleId])
  @@map("career_paths")
}

model Opportunity {
  id            String        @id @default(uuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  targetRoleId  String?
  targetRole    TargetRole?   @relation(fields: [targetRoleId], references: [id], onDelete: SetNull)
  title         String
  organization  String
  description   String?
  deadline      DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  applications  Application[]

  @@index([institutionId])
  @@index([targetRoleId])
  @@map("opportunities")
}

model Application {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        String      @default("APPLIED")
  appliedAt     DateTime    @default(now())

  @@unique([studentId, opportunityId])
  @@index([institutionId])
  @@index([opportunityId])
  @@index([institutionId, studentId, status])
  @@map("applications")
}

// ==========================================================
// ERP OPERATIONS
// ==========================================================

model ParentStudentLink {
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parentId      String
  parent        User        @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User        @relation("ChildLinks", fields: [studentId], references: [id], onDelete: Cascade)
  relationship  String?
  createdAt     DateTime    @default(now())

  @@id([parentId, studentId])
  @@index([institutionId, studentId])
  @@map("parent_student_links")
}

model TimetableEntry {
  id               String         @id @default(uuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  dayOfWeek        Int
  startTime        String
  endTime          String
  room             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([courseOfferingId, dayOfWeek, startTime])
  @@index([institutionId, dayOfWeek])
  @@map("timetable_entries")
}

model Exam {
  id               String         @id @default(uuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  title            String
  examDate         DateTime
  maxMarks         Float
  createdById      String
  results          ExamResult[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([institutionId, examDate])
  @@index([courseOfferingId])
  @@index([institutionId, courseOfferingId, examDate])
  @@map("exams")
}

model ExamResult {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  examId        String
  exam          Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks         Float
  remarks       String?
  enteredById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examId, studentId])
  @@index([institutionId, studentId])
  @@map("exam_results")
}

model FeeInvoice {
  id            String       @id @default(uuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String
  student       User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  amount        Float
  dueDate       DateTime?
  status        String       @default("PENDING")

  /// Billing lifecycle. `amount` remains the net payable so existing
  /// readers are unaffected; the breakdown below explains how it was
  /// reached and how much of it has settled.
  invoiceNumber     String?
  feeStructureId    String?
  feeStructure      FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  academicYearId    String?
  semesterId        String?
  installmentNumber Int       @default(1)
  grossAmount       Float?
  discountAmount    Float     @default(0)
  lateFeeAmount     Float     @default(0)
  paidAmount        Float     @default(0)
  refundedAmount    Float     @default(0)
  currency          String    @default("INR")
  notes             String?
  cancelledAt       DateTime?
  createdById       String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  payments      FeePayment[]
  transactions FeeTransaction[]
  items         FeeInvoiceItem[]
  concessions   FeeConcession[]
  refunds       FeeRefund[]
  receipts      FeeReceipt[]

  @@unique([institutionId, invoiceNumber])
  @@unique([institutionId, sourceEventKey])
  @@index([institutionId, studentId, status])
  @@index([institutionId, dueDate])
  @@index([institutionId, academicYearId, status, createdAt])
  @@index([institutionId, createdAt])
  @@map("fee_invoices")
}

model FeePayment {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       FeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  reference     String?
  paidAt        DateTime    @default(now())

  /// Settlement metadata. `provider*` fields are written by whichever
  /// payment gateway adapter handled the transaction and are the
  /// reconciliation join key.
  method            String    @default("OFFLINE")
  status            String    @default("SUCCESS")
  provider          String?
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  receiptNumber     String?
  refundedAmount    Float     @default(0)
  reconciledAt      DateTime?
  recordedById      String?
  notes             String?
  idempotencyKey    String?

  createdAt     DateTime    @default(now())
  User          User?       @relation(fields: [userId], references: [id])
  userId        String?

  receipt        FeeReceipt?
  refunds        FeeRefund[]
  transactions   FeeTransaction[]

  @@unique([institutionId, receiptNumber])
  @@unique([provider, providerPaymentId])
  @@unique([institutionId, idempotencyKey])
  @@index([institutionId, invoiceId])
  @@index([institutionId, status])
  @@index([institutionId, status, paidAt])
  @@index([institutionId, paidAt])
  @@map("fee_payments")
}

model FeeHead {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String
  description   String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  structures    FeeStructureItem[]
  invoiceItems  FeeInvoiceItem[]
  @@unique([institutionId, code])
  @@index([institutionId, isActive])
  @@map("fee_heads")
}

model FeeStructure {
  id             String       @id @default(uuid())
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name           String
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  programId      String?
  program        Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  semesterId     String?
  semester       Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  status         String       @default("DRAFT")
  currency       String       @default("INR")
  notes          String?
  createdById    String
  createdBy      User         @relation("FeeStructureCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items          FeeStructureItem[]
  invoices       FeeInvoice[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([institutionId, status])
  @@index([institutionId, academicYearId])
  @@index([institutionId, programId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id                String      @id @default(uuid())
  feeStructureId    String
  feeStructure      FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHeadId         String
  feeHead           FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
  amount            Decimal     @db.Decimal(14,2)
  dueDays           Int?
  installmentNumber Int         @default(1)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  @@unique([feeStructureId, feeHeadId, installmentNumber])
  @@index([feeStructureId])
  @@map("fee_structure_items")
}

model FeeInvoiceItem {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHeadId   String?
  feeHead     FeeHead?   @relation(fields: [feeHeadId], references: [id], onDelete: SetNull)
  description String
  amount      Decimal    @db.Decimal(14,2)
  createdAt   DateTime   @default(now())
  @@index([invoiceId])
  @@map("fee_invoice_items")
}

model FeeConcession {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       FeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId     String
  student       User        @relation("FeeConcessionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  type          String
  amount        Decimal     @db.Decimal(14,2)
  percentage    Decimal?    @db.Decimal(7,4)
  reason        String
  status        String      @default("PENDING")
  createdById   String
  createdBy     User        @relation("FeeConcessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById  String?
  approvedBy    User?       @relation("FeeConcessionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([institutionId, studentId, status])
  @@index([institutionId, status, createdAt])
  @@index([invoiceId])
  @@map("fee_concessions")
}

model FeeRefund {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  paymentId     String
  payment       FeePayment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId     String
  invoice       FeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  studentId     String
  student       User        @relation("FeeRefundStudent", fields: [studentId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(14,2)
  reason        String
  status        String      @default("REQUESTED")
  requestedById String
  requestedBy   User        @relation("FeeRefundRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById  String?
  approvedBy    User?       @relation("FeeRefundApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  processedById String?
  processedBy   User?       @relation("FeeRefundProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  processedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([institutionId, status])
  @@index([institutionId, status, createdAt])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("fee_refunds")
}

model FeeTransaction {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String?
  student       User?       @relation("FeeTransactionStudent", fields: [studentId], references: [id], onDelete: SetNull)
  invoiceId     String?
  invoice       FeeInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId     String?
  payment       FeePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount        Decimal     @db.Decimal(14,2)
  type          String
  reference     String?
  metadata      Json?
  createdById   String?
  createdBy     User?       @relation("FeeTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  @@index([institutionId, createdAt])
  @@index([institutionId, studentId])
  @@index([institutionId, type])
  @@map("fee_transactions")
}

model LibraryBook {
  id             String   @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title          String
  author         String?
  publisher      String?
  isbn           String?
  category       String?
  shelfLocation  String?
  totalCopies    Int      @default(1)
  availableCopies Int     @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  issues         LibraryIssue[]
  @@index([institutionId, isActive])
  @@index([institutionId, title])
  @@index([institutionId, isbn])
  @@map("library_books")
}

model LibraryIssue {
  id            String   @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  bookId        String
  book          LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
