// ==========================================================
// PUBLIC WEBSITE CMS
// ==========================================================

/// One dynamic public-site configuration document per institution.
/// The JSON payload is intentionally flexible so the public website can
/// evolve without repeated schema migrations for every text/image field.
model InstitutionalCmsContent {
  id            String      @id @default(uuid())
  institutionId String      @unique
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  content       Json
  version       Int         @default(1)
  publishedAt   DateTime    @default(now())
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId, updatedAt])
  @@map("institutional_cms_contents")
}

model SiteContent {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  content       Json
  version       Int         @default(1)
  publishedAt   DateTime    @default(now())
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId])
  @@index([institutionId, updatedAt])
  @@map("site_contents")
}


// ==========================================================
// ERP EXPANSION: admissions, HR, leave, library, calendar,
// course registration, promotion/transfer, certificates.
// Every table is tenant-scoped through institutionId.
// ==========================================================

model AdmissionApplication {
  id                  String       @id @default(uuid())
  institutionId       String
  institution         Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  applicationNumber   String
  firstName           String
  lastName            String
  email               String
  phone               String?
  dateOfBirth         DateTime?
  gender              String?
  guardianName        String?
  guardianPhone       String?
  previousInstitution String?
  previousPercentage  Float?
  programId           String
  program             Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYearId      String
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  /// SUBMITTED | UNDER_REVIEW | DOCUMENTS_PENDING | SELECTED | REJECTED | ENROLLED | WITHDRAWN
  status              String       @default("SUBMITTED")
  remarks             String?
  reviewedById        String?
  reviewedAt          DateTime?
  enrolledUserId      String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([institutionId, applicationNumber])
  @@index([institutionId, status])
  @@index([programId])
  @@index([academicYearId])
  @@map("admission_applications")
}

model EmployeeProfile {
  id                    String      @id @default(uuid())
  institutionId         String
  institution           Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode          String
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation           String
  /// FULL_TIME | PART_TIME | CONTRACT | VISITING
  employmentType        String      @default("FULL_TIME")
  joiningDate           DateTime
  /// ACTIVE | ON_LEAVE | RESIGNED | TERMINATED | RETIRED
  status                String      @default("ACTIVE")
  qualification         String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([institutionId, employeeCode])
  @@index([institutionId, status])
  @@index([departmentId])
  @@map("employee_profiles")
}

model LeaveType {
  id              String         @id @default(uuid())
  institutionId   String
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name            String
  code            String
  annualQuota     Int            @default(0)
  /// Role names allowed to apply (empty = every role).
  applicableRoles String[]
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  requests        LeaveRequest[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("leave_types")
}

model LeaveRequest {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     User        @relation("LeaveApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  fromDate      DateTime
  toDate        DateTime
  days          Int
  reason        String
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status        String      @default("PENDING")
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId, status])
  @@index([applicantId])
  @@index([leaveTypeId])
  @@map("leave_requests")
}

model LibraryBook {
  id              String         @id @default(uuid())
  institutionId   String
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title           String
  author          String
  isbn            String?
  category        String?
  publisher       String?
  shelfLocation   String?
  totalCopies     Int            @default(1)
  availableCopies Int            @default(1)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  issues          LibraryIssue[]

  @@unique([institutionId, isbn])
  @@index([institutionId, title])
  @@map("library_books")
}

model LibraryIssue {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  bookId        String
  book          LibraryBook @relation(fields: [bookId], references: [id], onDelete: Restrict)
  borrowerId    String
  borrower      User        @relation("LibraryBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  issuedById    String
  issuedAt      DateTime    @default(now())
  dueDate       DateTime
  returnedAt    DateTime?
  fineAmount    Float       @default(0)
  /// ISSUED | RETURNED | LOST
  status        String      @default("ISSUED")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId, status])
  @@index([institutionId, dueDate])
  @@index([borrowerId])
  @@index([bookId])
  @@map("library_issues")
}

model CalendarEvent {
  id             String        @id @default(uuid())
  institutionId  String
  institution    Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  /// HOLIDAY | EXAM | EVENT | DEADLINE | ACADEMIC
  eventType      String        @default("EVENT")
  startDate      DateTime
  endDate        DateTime
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  /// ALL | STUDENTS | FACULTY | STAFF
  audience       String        @default("ALL")
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([institutionId, startDate])
  @@index([institutionId, endDate])
  @@index([academicYearId])
  @@map("calendar_events")
}

model CourseRegistration {
  id               String         @id @default(uuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId        String
  student          User           @relation("RegistrationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  /// REQUESTED | APPROVED | REJECTED | DROPPED
  status           String         @default("REQUESTED")
  decidedById      String?
  decidedAt        DateTime?
  remarks          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentId, courseOfferingId])
  @@index([institutionId, status])
  @@index([studentId, status])
  @@index([courseOfferingId])
  @@map("course_registrations")
}

model StudentMovementRequest {
  id                  String      @id @default(uuid())
  institutionId       String
  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId           String
  student             User        @relation("MovementStudent", fields: [studentId], references: [id], onDelete: Cascade)
  /// PROMOTION | SECTION_TRANSFER | PROGRAM_TRANSFER
  requestType         String
  fromEnrollmentId    String
  targetProgramId     String?
  targetAcademicYearId String?
  targetSemesterId    String?
  targetSectionId     String?
  reason              String?
  /// PENDING | APPROVED | REJECTED
  status              String      @default("PENDING")
  requestedById       String
  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?
  appliedEnrollmentId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([institutionId, status])
  @@index([institutionId, requestType])
  @@index([studentId])
  @@map("student_movement_requests")
}

model Certificate {
  id                String      @id @default(uuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId         String
  student           User        @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  /// BONAFIDE | CHARACTER | TRANSFER | MARKSHEET | COURSE_COMPLETION
  certificateType   String
  certificateNumber String?
  purpose           String?
  /// REQUESTED | ISSUED | REJECTED
  status            String      @default("REQUESTED")
  requestedById     String
  issuedById        String?
  issuedAt          DateTime?
  remarks           String?
  /// Immutable snapshot of the facts certified at issue time.
  payload           Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([institutionId, certificateNumber])
  @@index([institutionId, status])
  @@index([institutionId, certificateType])
  @@index([studentId])
  @@map("certificates")
}


// ==========================================================
// OUTCOME BASED EDUCATION (OBE)
// ==========================================================

model ProgrammeOutcome {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programId     String
  program       Program     @relation(fields: [programId], references: [id], onDelete: Cascade)

  type         String
  code         String
  title        String?
  description  String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  mappings   CourseOutcomeMapping[]
  runResults ObeRunProgrammeOutcome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, type, code])
  @@index([institutionId, programId, type])
  @@map("programme_outcomes")
}

model CourseOutcome {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  code         String
  statement    String
  bloomLevel   String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  mappings           CourseOutcomeMapping[]
  assessmentItems    ObeAssessmentItem[]
  indirectAssessments ObeIndirectAssessment[]
  attainments        ObeCourseAttainment[]
  runResults         ObeRunCourseOutcome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, code])
  @@index([institutionId, courseId])
  @@map("course_outcomes")
}

model CourseOutcomeMapping {
  id                 String           @id @default(uuid())
  institutionId      String
  institution        Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseOutcomeId    String
  courseOutcome      CourseOutcome    @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)
  programmeOutcomeId String
  programmeOutcome   ProgrammeOutcome @relation(fields: [programmeOutcomeId], references: [id], onDelete: Cascade)

  level       Int
  remarks     String?
  status      String   @default("DRAFT")
  createdById String
  createdBy   User     @relation("ObeMappingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy   User?   @relation("ObeMappingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseOutcomeId, programmeOutcomeId])
  @@index([institutionId])
  @@index([programmeOutcomeId])
  @@map("course_outcome_mappings")
}

model ObeAttainmentPolicy {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programId     String?
  program       Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)

  name                    String
  scopeType               String  @default("INSTITUTION")
  directWeight            Float   @default(1)
  indirectWeight          Float   @default(0)
  level1Threshold         Float   @default(60)
  level2Threshold         Float   @default(70)
  level3Threshold         Float   @default(80)
  minimumPassingPercentage Float   @default(50)
  isDefault               Boolean @default(false)
  isActive                Boolean @default(true)
  formulaVersion          String  @default("v1")

  runs ObeAttainmentRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId, isActive])
  @@index([programId])
  @@map("obe_attainment_policies")
}

model ObeAssessment {
  id               String         @id @default(uuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  name           String
  type           String
  maxMarks       Float
  weightage      Float  @default(1)
  assessmentDate DateTime?
  sourceType     String?
  sourceId       String?
  status         String @default("DRAFT")

  createdById String
  createdBy   User @relation("ObeAssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items      ObeAssessmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId, courseOfferingId])
  @@index([sourceType, sourceId])
  @@map("obe_assessments")
}

model ObeAssessmentItem {
  id              String         @id @default(uuid())
  institutionId   String
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assessmentId    String
  assessment      ObeAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  courseOutcomeId String
  courseOutcome   CourseOutcome  @relation(fields: [courseOutcomeId], references: [id], onDelete: Restrict)

  itemCode     String
  description  String?
  maxMarks     Float
  displayOrder Int @default(0)

  scores ObeAssessmentScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, itemCode])
  @@index([institutionId, courseOutcomeId])
  @@map("obe_assessment_items")
}

model ObeAssessmentScore {
  id               String             @id @default(uuid())
  institutionId    String
  institution      Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assessmentItemId String
  assessmentItem   ObeAssessmentItem @relation(fields: [assessmentItemId], references: [id], onDelete: Cascade)
  studentId        String
  student          User               @relation("ObeScoreStudent", fields: [studentId], references: [id], onDelete: Cascade)

  marksObtained Float
  isAbsent      Boolean @default(false)
  remarks       String?
  enteredById   String
  enteredBy     User @relation("ObeScoreEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentItemId, studentId])
  @@index([institutionId, studentId])
  @@map("obe_assessment_scores")
}

model ObeIndirectAssessment {
  id               String         @id @default(uuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  courseOutcomeId  String
  courseOutcome    CourseOutcome  @relation(fields: [courseOutcomeId], references: [id], onDelete: Restrict)

  name            String
  type            String
  maxScore        Float
  responseCount   Int    @default(0)
  averageScore    Float?
  normalizedScore Float?
  weightage       Float  @default(1)
  status          String @default("DRAFT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId, courseOfferingId, courseOutcomeId])
  @@map("obe_indirect_assessments")
}

model ObeCourseAttainment {
  id               String         @id @default(uuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  courseOutcomeId  String
  courseOutcome    CourseOutcome  @relation(fields: [courseOutcomeId], references: [id], onDelete: Restrict)
  policyId         String?

  directAttainment   Float?
  indirectAttainment Float?
  finalAttainment    Float?
  attainmentLevel    Int?
  studentCount          Int @default(0)
  studentsAssessed      Int @default(0)
  studentsMeetingTarget Int @default(0)
  calculationStatus String @default("CALCULATED")
  calculatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseOfferingId, courseOutcomeId])
  @@index([institutionId])
  @@map("obe_course_attainments")
}

model ObeAttainmentRun {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programId      String
  program        Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYearId String
  semesterId     String
  policyId       String?
  policy         ObeAttainmentPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  name           String
  status         String @default("DRAFT")
  formulaVersion String @default("v1")
  calculatedById String?
  calculatedBy   User? @relation("ObeRunCalculatedBy", fields: [calculatedById], references: [id], onDelete: SetNull)
  calculatedAt   DateTime?
  approvedById   String?
  approvedBy     User? @relation("ObeRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?

  courseResults    ObeRunCourseOutcome[]
  programmeResults ObeRunProgrammeOutcome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId, programId, academicYearId, semesterId])
  @@map("obe_attainment_runs")
}

model ObeRunCourseOutcome {
  id               String           @id @default(uuid())
  institutionId    String
  institution      Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  runId            String
  run              ObeAttainmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  courseOutcomeId  String
  courseOutcome    CourseOutcome    @relation(fields: [courseOutcomeId], references: [id], onDelete: Restrict)

  directAttainment   Float?
  indirectAttainment Float?
  finalAttainment    Float?
  attainmentLevel    Int?
  studentCount          Int @default(0)
  studentsAssessed      Int @default(0)
  studentsMeetingTarget Int @default(0)

  @@unique([runId, courseOfferingId, courseOutcomeId])
  @@index([institutionId, courseOfferingId])
  @@map("obe_run_course_outcomes")
}

model ObeRunProgrammeOutcome {
  id                 String           @id @default(uuid())
  institutionId      String
  institution        Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  runId              String
  run                ObeAttainmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  programmeOutcomeId String
  programmeOutcome   ProgrammeOutcome @relation(fields: [programmeOutcomeId], references: [id], onDelete: Restrict)

  attainment             Float?
  attainmentLevel        Int?
  courseCount            Int @default(0)
  contributingCourseCount Int @default(0)

  @@unique([runId, programmeOutcomeId])
  @@index([institutionId, programmeOutcomeId])
  @@map("obe_run_programme_outcomes")
}

// ==========================================================
// AUTHENTICATION HARDENING
// ==========================================================

/// Single-use password reset grant. Only the SHA-256 hash of the token
/// is stored, so a database read never yields a usable reset link.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

/// One-time MFA bypass code, hashed. Consumed on use and never reissued.
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Short-lived handle issued after a correct password when MFA is on.
/// It is not an access token: it only authorises the second factor step.
model MfaChallenge {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeHash String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  attempts      Int       @default(0)
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("mfa_challenges")
}