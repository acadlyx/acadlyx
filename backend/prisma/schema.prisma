/// One dynamic public-site configuration document per institution.
/// The JSON payload is intentionally flexible so the public website can
/// evolve without repeated schema migrations for every text/image field.
model SiteContent {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  content       Json
  version       Int         @default(1)
  publishedAt   DateTime    @default(now())
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId])
  @@index([institutionId, updatedAt])
  @@map("site_contents")
}


// ==========================================================
// ERP EXPANSION: admissions, HR, leave, library, calendar,
// course registration, promotion/transfer, certificates.
// Every table is tenant-scoped through institutionId.
// ==========================================================

model AdmissionApplication {
  id                  String       @id @default(uuid())
  institutionId       String
  institution         Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  applicationNumber   String
  firstName           String
  lastName            String
  email               String
  phone               String?
  dateOfBirth         DateTime?
  gender              String?
  guardianName        String?
  guardianPhone       String?
  previousInstitution String?
  previousPercentage  Float?
  programId           String
  program             Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYearId      String
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  /// SUBMITTED | UNDER_REVIEW | DOCUMENTS_PENDING | SELECTED | REJECTED | ENROLLED | WITHDRAWN
  status              String       @default("SUBMITTED")
  remarks             String?
  reviewedById        String?
  reviewedAt          DateTime?
  enrolledUserId      String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([institutionId, applicationNumber])
  @@index([institutionId, status])
  @@index([programId])
  @@index([academicYearId])
  @@map("admission_applications")
}

model EmployeeProfile {
