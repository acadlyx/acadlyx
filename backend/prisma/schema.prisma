model Certificate {
  id                String      @id @default(uuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId         String
  student           User        @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  /// BONAFIDE | CHARACTER | TRANSFER | MARKSHEET | COURSE_COMPLETION
  certificateType   String
  certificateNumber String?
  purpose           String?
  /// REQUESTED | ISSUED | REJECTED
  status            String      @default("REQUESTED")
  requestedById     String
  issuedById        String?
  issuedAt          DateTime?
  remarks           String?
  /// Immutable snapshot of the facts certified at issue time.
  payload           Json?
