model FeeInvoice {
  id            String       @id @default(uuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String
  student       User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  amount        Float
  dueDate       DateTime?
  status        String       @default("PENDING")

  /// Billing lifecycle. `amount` remains the net payable so existing
  /// readers are unaffected; the breakdown below explains how it was
  /// reached and how much of it has settled.
  invoiceNumber     String?
  feeStructureId    String?
  academicYearId    String?
  semesterId        String?
  installmentNumber Int       @default(1)
  grossAmount       Float?
  discountAmount    Float     @default(0)
  lateFeeAmount     Float     @default(0)
  paidAmount        Float     @default(0)
  refundedAmount    Float     @default(0)
  currency          String    @default("INR")
  notes             String?
  cancelledAt       DateTime?
  createdById       String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  payments      FeePayment[]

  @@unique([institutionId, invoiceNumber])
  @@index([institutionId, studentId, status])
  @@index([institutionId, dueDate])
  @@map("fee_invoices")
}

model FeePayment {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       FeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  reference     String?
  paidAt        DateTime    @default(now())

  /// Settlement metadata. `provider*` fields are written by whichever
  /// payment gateway adapter handled the transaction and are the
  /// reconciliation join key.
  method            String    @default("OFFLINE")
  status            String    @default("SUCCESS")
  provider          String?
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  receiptNumber     String?
  refundedAmount    Float     @default(0)
  reconciledAt      DateTime?
  recordedById      String?
  notes             String?

  createdAt     DateTime    @default(now())
  User          User?       @relation(fields: [userId], references: [id])
  userId        String?

  @@unique([institutionId, receiptNumber])
  @@unique([provider, providerPaymentId])
  @@index([institutionId, invoiceId])
  @@index([institutionId, status])
  @@map("fee_payments")
}

model Notice {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  body          String
